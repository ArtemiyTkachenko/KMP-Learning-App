{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "negotiationIteration": {"type": "integer", "minimum": 1, "maximum": 5},
    "finalConsensusCheck": {"type": "boolean"},
    "verdict": {"type": "string", "enum": ["ACCEPT", "CHANGES_REQUESTED"]},
    "consensus": {"type": "boolean"},
    "summary": {"type": "string"},
    "positionBrief": {"type": "string"},
    "responseToClaude": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "severity": {"type": "string", "enum": ["BLOCKING", "IMPORTANT", "OPTIONAL"]},
          "status": {"type": "string", "enum": ["NEW", "MAINTAINED", "NARROWED", "WITHDRAWN"]},
          "file": {"type": "string"},
          "line": {"type": "string"},
          "problem": {"type": "string"},
          "evidence": {"type": "string"},
          "rationale": {"type": "string"},
          "requestedChange": {"type": "string"},
          "responseToClaude": {"type": "string"}
        },
        "required": [
          "id", "severity", "status", "file", "line", "problem", "evidence",
          "rationale", "requestedChange", "responseToClaude"
        ]
      }
    },
    "acceptanceCriteriaStatus": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "criterion": {"type": "string"},
          "status": {"type": "string", "enum": ["SATISFIED", "NOT_SATISFIED", "NOT_VALIDATED"]},
          "evidence": {"type": "string"}
        },
        "required": ["criterion", "status", "evidence"]
      }
    },
    "residualRisks": {"type": "array", "items": {"type": "string"}}
  },
  "required": [
    "negotiationIteration", "finalConsensusCheck", "verdict", "consensus",
    "summary", "positionBrief", "responseToClaude", "findings",
    "acceptanceCriteriaStatus", "residualRisks"
  ]
}
