{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "negotiationIteration": {"type": "integer", "minimum": 0, "maximum": 5},
    "mode": {"type": "string", "enum": ["IMPLEMENTATION", "RESPONSE", "SELF_REVIEW_FIX"]},
    "summary": {"type": "string"},
    "positionBrief": {"type": "string"},
    "findingResponses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "findingId": {"type": "string"},
          "stance": {"type": "string", "enum": ["ACCEPT", "PARTIAL", "REJECT"]},
          "reasoning": {"type": "string"},
          "actionTaken": {"type": "string"},
          "remainingDisagreement": {"type": "boolean"}
        },
        "required": ["findingId", "stance", "reasoning", "actionTaken", "remainingDisagreement"]
      }
    },
    "implementationSummary": {"type": "array", "items": {"type": "string"}},
    "validationPerformed": {"type": "array", "items": {"type": "string"}},
    "unresolvedConcerns": {"type": "array", "items": {"type": "string"}}
  },
  "required": [
    "negotiationIteration", "mode", "summary", "positionBrief", "findingResponses",
    "implementationSummary", "validationPerformed", "unresolvedConcerns"
  ]
}
